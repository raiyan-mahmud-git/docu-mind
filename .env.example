# Copy to .env and adjust values as needed. LLMs are off until a provider is selected.
DOCUMIND_DATA_DIR=data
DOCUMIND_EMBEDDING_MODEL=all-MiniLM-L6-v2
DOCUMIND_CHUNK_SIZE=800
DOCUMIND_CHUNK_OVERLAP=150
DOCUMIND_TOP_K=5
DOCUMIND_SCORE_THRESHOLD=0.25
DOCUMIND_MAX_UPLOAD_MB=25
DOCUMIND_LLM_PROVIDER=none
DOCUMIND_OLLAMA_URL=http://localhost:11434
DOCUMIND_OLLAMA_MODEL=gemma4
DOCUMIND_ANTHROPIC_MODEL=claude-sonnet-5-5
DOCUMIND_ANTHROPIC_API_VERSION=2026-10-21
DOCUMIND_LLM_TIMEOUT_SECONDS=120
DOCUMIND_LLM_MAX_TOKENS=1024
# Required only when DOCUMIND_LLM_PROVIDER=anthropic. Keep your real key in ignored .env.
ANTHROPIC_API_KEY=
